{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/guides-review.schema.json",
  "title": "Structured Engineering Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "findings",
    "checks",
    "risks",
    "unverified"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["proceed", "revise", "stop"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "result"],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unverified": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
